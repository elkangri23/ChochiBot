{
  "name": "chochibot",
  "version": "1.0.0",
  "description": "ChochiBot – Agente de IA personal",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:clean": "set NODE_OPTIONS=--disable-warning=DEP0040 && tsx src/index.ts",
    "dev:trace": "tsx src/index.ts --trace-deprecation",
    "build": "tsc",
    "start": "node --disable-warning=DEP0040 dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "mysql2": "^3.19.1",
    "node-ssh": "^13.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.8.0",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18"
  }
}
